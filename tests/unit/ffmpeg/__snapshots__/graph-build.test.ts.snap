exports[`an upper video track is composited with overlay and frame-number enable 1`] = `
[
  "[0:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=0:end_frame=60,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=60,settb=expr=1/30,setpts=N[v0]",
  "[1:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=0:end_frame=30,settb=expr=1/30,setpts=N,scale=iw*0.25:-2:flags=bicubic,setsar=1,format=yuva420p,colorchannelmixer=aa=0.5,trim=end_frame=30,settb=expr=1/30,setpts=N[v1]",
  "[v1]setpts=PTS+0.333333/TB[v2]",
  "[v0][v2]overlay=x=W-w-8:y=8:enable='between(n,10,39)':eof_action=pass:shortest=0:format=auto,settb=expr=1/30,setpts=N[v3]",
  "[v3]fps=30/1,trim=end_frame=60,settb=expr=1/30,setpts=N,format=yuv420p[V4]",
  "anullsrc=r=48000:cl=stereo,atrim=end_sample=96000[a5]",
  "[a5]volume=0dB,apad=whole_len=96000,atrim=end_sample=96000,asetpts=PTS-STARTPTS[a6]",
]
`;

