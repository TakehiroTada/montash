exports[`clips without transitions are concatenated with background gaps 1`] = `
[
  "[0:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=0:end_frame=30,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=30,settb=expr=1/30,setpts=N[v0]",
  "color=c=#000000:s=320x180:r=30/1,trim=end_frame=15,settb=expr=1/30,setpts=N[v1]",
  "[1:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=60:end_frame=90,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=30,settb=expr=1/30,setpts=N[v2]",
  "[v0][v1][v2]concat=n=3:v=1:a=0,fps=30/1,trim=end_frame=75,settb=expr=1/30,setpts=N[v3]",
  "[v3]fps=30/1,trim=end_frame=75,settb=expr=1/30,setpts=N,format=yuv420p[V4]",
  "anullsrc=r=48000:cl=stereo,atrim=end_sample=120000[a5]",
  "[a5]volume=0dB,apad=whole_len=120000,atrim=end_sample=120000,asetpts=PTS-STARTPTS[a6]",
]
`;

exports[`a transition folds into xfade and the untouched cut stays a concat 1`] = `
[
  "[0:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=0:end_frame=35,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=35,settb=expr=1/30,setpts=N[v0]",
  "[1:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=55:end_frame=90,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=35,settb=expr=1/30,setpts=N[v1]",
