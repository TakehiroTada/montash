  "[1:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=start_sample=0:end_sample=144000,asetpts=PTS-STARTPTS,apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS,volume=0dB[a2]",
  "[a2]apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS[a3]",
  "[2:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=start_sample=0:end_sample=144000,asetpts=PTS-STARTPTS,apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS,volume=-12dB,afade=t=out:ss=48000:ns=96000:curve=tri[a4]",
  "[a4]atrim=start_sample=480,asetpts=PTS-STARTPTS[a5]",
  "[a5]apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS[a6]",
