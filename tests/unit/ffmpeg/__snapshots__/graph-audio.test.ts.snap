exports[`ducking splits the sidechain and compresses the target (docs/07 §8.3) 1`] = `
[
  "[0:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=0:end_frame=90,settb=expr=1/30,setpts=N,scale=320:180:force_original_aspect_ratio=decrease:flags=bicubic,pad=320:180:(ow-iw)/2:(oh-ih)/2:color=#000000,setsar=1,format=yuv420p,trim=end_frame=90,settb=expr=1/30,setpts=N[v0]",
  "[v0]fps=30/1,trim=end_frame=90,settb=expr=1/30,setpts=N,format=yuv420p[V1]",
  "[1:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=start_sample=0:end_sample=144000,asetpts=PTS-STARTPTS,apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS,volume=0dB[a2]",
  "[a2]apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS[a3]",
  "[2:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=start_sample=0:end_sample=144000,asetpts=PTS-STARTPTS,apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS,volume=0dB[a4]",
  "[a4]apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS[a5]",
  "[a3]asplit=2[a6][a7]",
  "[a5][a7]sidechaincompress=threshold=0.031623:ratio=8:attack=20:release=500:makeup=1[a8]",
  "[a6][a8]amix=inputs=2:normalize=0:dropout_transition=0[a9]",
  "[a9]volume=0dB,apad=whole_len=144000,atrim=end_sample=144000,asetpts=PTS-STARTPTS[a10]",
]
`;

