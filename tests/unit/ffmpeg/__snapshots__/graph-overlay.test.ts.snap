  "[2:V:0]setpts=PTS-STARTPTS,fps=30/1,trim=start_frame=60:end_frame=90,settb=expr=1/30,setpts=N,scale=iw*0.3:-2:flags=bicubic,setsar=1,format=yuva420p,trim=end_frame=30,settb=expr=1/30,setpts=N[v3]",
