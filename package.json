{
  "name": "montash",
  "version": "0.0.1",
  "description": "montash — CLI video editor operated by AI (montage + sh)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "bin": {
    "montash": "./bin/montash"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "doctor": "bun src/cli/index.ts doctor",
    "test": "bun test",
    "e2e:preview": "bun scripts/e2e-preview.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run check:spec && bun run check:spikes && bun test",
    "build:web": "bun build web/index.html --outdir web/dist --minify",
    "compile": "bun build --compile src/cli/index.ts --outfile dist/montash",
    "spikes": "cd scripts/spikes && bun install && bun run all && cd ../.. && bun scripts/check-bun-spikes.ts update",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "format": "bunx --bun biome format --write .",
    "verify": "bun run check && bash tests/workflows/run-all.sh",
    "licenses": "bun scripts/collect-licenses.ts",
    "check:spec": "bun scripts/check-spec-drift.ts",
    "check:spikes": "bun scripts/check-bun-spikes.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yargs": "^17.7.2",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yargs": "^17.0.33",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
